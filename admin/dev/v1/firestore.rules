
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    function signedIn() {
      return request.auth != null;
    }

    match /admins/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid);

      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'client';

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }

    match /clients/{id} {
      allow read, write: if isAdmin();
    }

    match /filings/{id} {
      allow read, write: if isAdmin();
    }

    match /documents/{id} {
      allow read, write: if isAdmin();
    }

    match /requests/{id} {
      allow read, write: if isAdmin();
    }

    match /payments/{id} {
      allow read, write: if isAdmin();
    }

    match /compliance/{id} {
      allow read, write: if isAdmin();
    }

    match /credentials/{id} {
      allow read, write: if isAdmin();
    }

    match /tasks/{id} {
      allow read, write: if isAdmin();
    }

    match /invoices/{id} {
      allow read, write: if isAdmin();
    }

    match /ledgers/{id} {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
